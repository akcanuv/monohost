.DS_Store
__pycache__/
*.pyc
.venv/
# the dashboard is bundled into this repo (run from dir: dashboard); examples are a separate repo
examples/
# secrets / live runtime state must never be committed (belt-and-suspenders; real state lives in
# /opt/monohost, not the repo — but guard against a stray copy under cloudflare/ or secrets/)
secrets/
*.token
# local ops runbooks — real hostnames/users/UUIDs, must not land in a public repo
MONGO-RS-ROLLBACK.md
cloudflare/zones.env
cloudflare/config.yml
cloudflare/*.json
