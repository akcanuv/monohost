#!/bin/bash
# monohost — lifecycle CLI for the single-host control plane.
#
#   monohost start      start every monohost daemon (caddy, deployd, dashboard, cloudflared, apps)
#   monohost stop       stop them all (config, apps, and data are left intact)
#   monohost restart    stop + start
#   monohost status     daemon states, registered apps, and the dashboard URL
#   monohost update     fetch the latest monohost software and re-apply (reusing your config)
#   monohost version    print version + source repo
#
# Installed root-owned at /usr/local/bin/monohost by setup.sh. Lifecycle verbs re-exec under sudo
# (managing system LaunchDaemons needs root); the installer starts monohost by default.

set -uo pipefail

MH_ROOT=/opt/monohost
LAUNCHCTL=/bin/launchctl
SCUTIL=/usr/sbin/scutil
DAEMON_DIR=/Library/LaunchDaemons
# canonical monohost software repo (override with MONOHOST_REPO=...). This is the SOFTWARE, distinct
# from the user's own app repos.
MONOHOST_REPO="${MONOHOST_REPO:-https://github.com/akcanuv/monohost}"
MH_VERSION="1.0"
ADMIN_USER=mh-admin
CF_DIR="$MH_ROOT/cloudflare"
ZONES_ENV="$CF_DIR/zones.env"
CERTS_DIR="$CF_DIR/certs"
DOMAINS_TSV="$MH_ROOT/registry/domains.tsv"
EXPOSURES="$MH_ROOT/registry/exposures.tsv"
CLOUDFLARED=/opt/homebrew/bin/cloudflared
LOCK="$MH_ROOT/registry/.lock"

c_reset=$'\033[0m'; c_blue=$'\033[34m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_red=$'\033[31m'
log()  { printf '%s[monohost]%s %s\n' "$c_blue"   "$c_reset" "$*"; }
ok()   { printf '%s   [ok]%s   %s\n'  "$c_green"  "$c_reset" "$*"; }
warn() { printf '%s [warn]%s   %s\n'  "$c_yellow" "$c_reset" "$*"; }
die()  { printf '%s [fail]%s   %s\n'  "$c_red"    "$c_reset" "$*" >&2; exit 1; }

lan_host() { local l; l="$($SCUTIL --get LocalHostName 2>/dev/null)"; [ -n "$l" ] && echo "$l.local" || hostname; }

# Ordered: control plane first (caddy → deployd → cloudflared → dashboard), then one per app. A plist
# may be absent (cloudflared exists only when public exposure is configured).
daemon_labels() {
  local ordered=(com.monohost.caddy com.monohost.deployd com.monohost.cloudflared com.monohost.dashboard)
  local seen=" " l f base
  for l in "${ordered[@]}"; do [ -f "$DAEMON_DIR/$l.plist" ] && { echo "$l"; seen="$seen$l "; }; done
  for f in "$DAEMON_DIR"/com.monohost.*.plist; do
    [ -e "$f" ] || continue
    base="$(basename "$f" .plist)"
    case "$seen" in *" $base "*) ;; *) echo "$base";; esac
  done
}

cmd_start() {
  local l
  for l in $(daemon_labels); do
    if $LAUNCHCTL print "system/$l" >/dev/null 2>&1; then ok "$l already running"
    elif $LAUNCHCTL bootstrap system "$DAEMON_DIR/$l.plist" 2>/dev/null; then ok "$l started"
    else warn "$l failed to start (see $MH_ROOT/logs/)"; fi
  done
  log "dashboard → http://$(lan_host)/dashboard/"
}

cmd_stop() {
  local l
  for l in $(daemon_labels); do
    if $LAUNCHCTL bootout "system/$l" 2>/dev/null; then ok "$l stopped"; else warn "$l not running"; fi
  done
}

cmd_restart() { cmd_stop; sleep 1; cmd_start; }

cmd_status() {
  printf 'monohost %s — control plane on %s\n\n' "$MH_VERSION" "$(lan_host)"
  printf '  %-26s %s\n' DAEMON STATE
  local l pid st
  for l in $(daemon_labels); do
    if $LAUNCHCTL print "system/$l" >/dev/null 2>&1; then
      pid="$($LAUNCHCTL print "system/$l" 2>/dev/null | awk -F'= ' '/[[:space:]]pid =/{print $2; exit}')"
      st="${pid:+running (pid ${pid// /})}"; st="${st:-loaded}"
    else st="stopped"; fi
    printf '  %-26s %s\n' "$l" "$st"
  done
  printf '\n  %-16s %s\n' APP PORT
  if [ -f "$MH_ROOT/registry/apps.tsv" ]; then
    awk -F'\t' '$1!~/^#/ && $1!=""{printf "  %-16s %s\n",$1,($4==""?"—":$4)}' "$MH_ROOT/registry/apps.tsv"
  else echo "  (none registered)"; fi
  printf '\ndashboard → http://%s/dashboard/\n' "$(lan_host)"
}

cmd_update() {
  command -v git >/dev/null 2>&1 || die "git not found"
  local tmp; tmp="$(mktemp -d /tmp/monohost.XXXXXX)" || die "mktemp failed"
  # expand $tmp NOW (double quotes): the EXIT trap fires after this function returns, when the
  # `local` is out of scope — a deferred "$tmp" is an unbound-variable error under set -u and
  # leaks the clone dir.
  trap "rm -rf '$tmp'" EXIT
  log "fetching latest monohost from $MONOHOST_REPO"
  git clone --depth 1 "$MONOHOST_REPO" "$tmp/src" >/dev/null 2>&1 || die "clone failed ($MONOHOST_REPO)"
  [ -f "$tmp/src/setup.sh" ] || die "cloned repo has no setup.sh"
  log "re-applying setup (idempotent; your domain/token/tunnel config is reused, never re-prompted)"
  MH_NONINTERACTIVE=1 bash "$tmp/src/setup.sh" all || die "setup failed"
  ok "monohost updated"
}

# ---- multi-domain management
# All domains ride the ONE existing tunnel; per-domain zone certs only automate DNS routing.

load_zones() {           # -> BASE_DOMAIN, DEV_BASE, TUNNEL in scope; 1 if exposure unconfigured
  [ -f "$ZONES_ENV" ] || return 1
  # shellcheck disable=SC1090
  . "$ZONES_ENV" 2>/dev/null
  [ -n "${BASE_DOMAIN:-}" ] && [ -n "${TUNNEL:-}" ] || return 1
  case "$BASE_DOMAIN$TUNNEL" in *REPLACE-*) return 1 ;; esac
  return 0
}

valid_domain() { echo "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'; }

domain_registered() { [ -f "$DOMAINS_TSV" ] && awk -F'\t' -v d="$1" '$1==d{f=1} END{exit !f}' "$DOMAINS_TSV"; }

# serialize registry mutations with onboard/offboard/expose/unexpose (shared mkdir lock).
acquire_lock() {
  [ -n "${MH_LOCK_HELD:-}" ] && return 0
  local tries=0 holder
  while ! mkdir "$LOCK" 2>/dev/null; do
    holder="$(cat "$LOCK/pid" 2>/dev/null)"
    if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then rm -rf "$LOCK" 2>/dev/null; continue; fi
    tries=$((tries + 1)); [ "$tries" -gt 300 ] && die "timed out waiting for $LOCK (held by ${holder:-?})"
    sleep 0.1
  done
  echo "$$" > "$LOCK/pid"; export MH_LOCK_HELD=$$
  trap 'rm -rf "$LOCK" 2>/dev/null' EXIT INT TERM
}

domain_add() {
  local dom="$1" canon="/Users/$ADMIN_USER/.cloudflared/cert.pem" cert moved="" out
  [ -n "$dom" ] || die "usage: monohost domain add <domain>"
  dom="$(echo "$dom" | tr '[:upper:]' '[:lower:]')"
  valid_domain "$dom" || die "invalid domain '$dom'"
  load_zones || die "public exposure is not configured — set up the first domain via the installer (MH_DOMAIN=... monohost update)"
  [ "$dom" = "$BASE_DOMAIN" ] && die "'$dom' is the install domain — already registered"
  domain_registered "$dom" && die "'$dom' is already registered (see: monohost domain list)"
  [ -x "$CLOUDFLARED" ] || die "cloudflared not found at $CLOUDFLARED"

  install -d -o "$ADMIN_USER" -g staff -m 700 "$CERTS_DIR"
  cert="$CERTS_DIR/$dom.pem"
  # crash recovery: a persisting mh-save is always the TRUE original — restore it unconditionally
  # (a hard-killed prior add may have left a wrong-zone cert at the canonical path).
  [ -f "$canon.mh-save" ] && { rm -f "$canon"; mv "$canon.mh-save" "$canon"; }

  if [ -f "$cert" ]; then
    ok "zone cert for $dom already present — skipping browser auth"
  else
    # move-aside dance: `tunnel login` always writes the canonical cert.pem; park the existing one
    # so login can't clobber it, restore it on every exit path.
    restore_canon() { [ -n "$moved" ] && [ -f "$canon.mh-save" ] && mv "$canon.mh-save" "$canon"; }
    [ -f "$canon" ] && { mv "$canon" "$canon.mh-save"; moved=1; }
    trap 'restore_canon' EXIT
    trap 'restore_canon; exit 130' INT TERM
    log "Authorizing with Cloudflare — a login URL will open/print."
    log "IMPORTANT: in the browser, pick the zone for '$dom' (NOT $BASE_DOMAIN)."
    if ! sudo -H -u "$ADMIN_USER" "$CLOUDFLARED" tunnel login; then
      restore_canon; die "cloudflared tunnel login failed"
    fi
    [ -f "$canon" ] || { restore_canon; die "login did not produce a cert at $canon"; }
    install -o "$ADMIN_USER" -g staff -m 600 "$canon" "$cert" || die "could not store the zone cert at $cert"
    rm -f "$canon"
    restore_canon
    trap - EXIT INT TERM
    ok "zone cert stored at $cert"
  fi

  # one-time dev CNAME (covers every dev app on this domain). Tolerate "already exists".
  if out="$(sudo -H -u "$ADMIN_USER" /usr/bin/env TUNNEL_ORIGIN_CERT="$cert" "$CLOUDFLARED" tunnel route dns "$TUNNEL" "dev.$dom" 2>&1)"; then
    ok "dev CNAME dev.$dom -> $TUNNEL.cfargotunnel.com"
  elif echo "$out" | grep -qi 'already exists\|already configured'; then
    ok "dev CNAME dev.$dom already exists"
  else
    printf '%s\n' "$out" >&2
    die "could not create the dev.$dom CNAME. Wrong zone picked in the browser? rm $cert and re-run. Or add CNAME dev.$dom -> $TUNNEL.cfargotunnel.com in the Cloudflare dashboard, then re-run."
  fi

  # register LAST (atomic) — a half-finished add must never land in the registry the UI offers.
  acquire_lock
  touch "$DOMAINS_TSV"
  awk -F'\t' -v d="$dom" '$1!=d' "$DOMAINS_TSV" > "$DOMAINS_TSV.tmp"
  printf '%s\t%s\n' "$dom" "dev.$dom" >> "$DOMAINS_TSV.tmp"
  mv "$DOMAINS_TSV.tmp" "$DOMAINS_TSV"
  chown "$ADMIN_USER":staff "$DOMAINS_TSV"; chmod 644 "$DOMAINS_TSV"
  ok "registered '$dom'  (prod: <app>.$dom · dev: dev.$dom/<app>/)"
  log "expose an app on it from the dashboard's domain dropdown"
}

domain_list() {
  load_zones || { warn "public exposure is not configured — no domains"; return 0; }
  printf '  %-28s %-30s %-8s %-5s %s\n' DOMAIN DEV_BASE DEFAULT CERT APPS
  {
    printf '%s\t%s\n' "$BASE_DOMAIN" "${DEV_BASE:-dev.$BASE_DOMAIN}"
    [ -f "$DOMAINS_TSV" ] && awk -F'\t' -v b="$BASE_DOMAIN" '$1!~/^#/ && $1!="" && $1!=b' "$DOMAINS_TSV"
  } | while IFS=$'\t' read -r d db; do
    [ -n "$d" ] || continue
    [ -n "$db" ] || db="dev.$d"
    def="-"; [ "$d" = "$BASE_DOMAIN" ] && def="yes"
    cert="no"
    if [ -r "$CERTS_DIR/$d.pem" ]; then cert="yes"
    elif [ "$d" = "$BASE_DOMAIN" ] && [ -r "/Users/$ADMIN_USER/.cloudflared/cert.pem" ]; then cert="yes"; fi
    n="$(awk -F'\t' -v d="$d" -v b="$BASE_DOMAIN" '$1!~/^#/ && $1!="" { dm=(NF>=5 && $5!="" ? $5 : b); if (dm==d) c++ } END{print c+0}' "$EXPOSURES" 2>/dev/null)"
    printf '  %-28s %-30s %-8s %-5s %s\n' "$d" "$db" "$def" "$cert" "${n:-0}"
  done
}

domain_remove() {
  local dom="$1" inuse
  [ -n "$dom" ] || die "usage: monohost domain remove <domain>"
  dom="$(echo "$dom" | tr '[:upper:]' '[:lower:]')"
  load_zones || die "public exposure is not configured"
  [ "$dom" = "$BASE_DOMAIN" ] && die "'$dom' is the install domain (zones.env) — it cannot be removed"
  domain_registered "$dom" || die "'$dom' is not registered (see: monohost domain list)"
  acquire_lock
  inuse="$(awk -F'\t' -v d="$dom" '$1!~/^#/ && NF>=5 && $5==d {print $1}' "$EXPOSURES" 2>/dev/null | tr '\n' ' ')"
  [ -n "${inuse// /}" ] && die "apps still exposed on $dom — unexpose them first: $inuse"
  awk -F'\t' -v d="$dom" '$1!=d' "$DOMAINS_TSV" > "$DOMAINS_TSV.tmp"
  mv "$DOMAINS_TSV.tmp" "$DOMAINS_TSV"
  chown "$ADMIN_USER":staff "$DOMAINS_TSV"; chmod 644 "$DOMAINS_TSV"
  rm -f "$CERTS_DIR/$dom.pem"
  rmdir "$MH_ROOT/caddy/public-dev/$dom" 2>/dev/null || true
  ok "removed '$dom' (its DNS records are left in place — delete them in the Cloudflare dashboard if you wish)"
}

cmd_domain() {
  local action="${1:-list}"; shift || true
  case "$action" in
    add)    domain_add "${1:-}" ;;
    list)   domain_list ;;
    remove) domain_remove "${1:-}" ;;
    *)      die "usage: monohost domain <add|list|remove> [domain]" ;;
  esac
}

usage() {
  cat <<EOF
monohost $MH_VERSION — single-host deploy plane

usage: monohost <command>

  start      start every monohost daemon
  stop       stop them all (config + apps preserved)
  restart    stop + start
  status     daemon states, apps, dashboard URL
  update     fetch the latest monohost and re-apply (reuses your config)
  domain     manage exposure domains: domain add <d> | domain list | domain remove <d>
  version    print version
EOF
}

SUBCMD="${1:-help}"; shift || true
case "$SUBCMD" in
  start|stop|restart|status|update|domain)
    [ "$(id -u)" -eq 0 ] || exec sudo "$0" "$SUBCMD" "$@"
    "cmd_$SUBCMD" "$@" ;;
  version|-v|--version) printf 'monohost %s (%s)\n' "$MH_VERSION" "$MONOHOST_REPO" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
