# monohost master Caddyfile — LAN name routing (path-based) + Cloudflare public host blocks.
# Installed mh-admin-owned at /opt/monohost/caddy/Caddyfile (control plane, immutable to deployer).
# Caddy runs as root (to bind :80); per-app route fragments live in caddy/apps/<name>.caddy.
#
# DOMAIN-AGNOSTIC: this file carries no literal domain. The public DEV host block is generated by
# expose.sh from the operator's DEV_BASE (zones.env) into caddy/public-dev-host/, and each public
# PROD subdomain block is generated into caddy/public/. Empty globs are a no-op, so a fresh box with
# nothing exposed still validates.

{
	# admin API stays on its default loopback (127.0.0.1:2019) so `caddy reload` can apply
	# route changes with zero downtime (needed once the dashboard onboards apps dynamically).
	auto_https off
}

:80 {
	# Control-plane dashboard lives at /dashboard/ (its route is in the master config, not a
	# deployer-owned fragment, since it's infra). handle_path strips the /dashboard prefix.
	# The dashboard itself rejects mutations that don't arrive with a LAN Host + admin token,
	# so reaching this listener via a stray public ingress can't drive the control plane.
	# NOTE: in `redir`, a leading /path token is an inline MATCHER, not the target — the
	# matcher/to/code form below is the only one that redirects bare /dashboard to /dashboard/.
	redir /dashboard /dashboard/ 308
	handle_path /dashboard/* {
		reverse_proxy 127.0.0.1:8010
	}

	# Per-app LAN routes (<this-mac>.local/<name>/), written by onboard.sh.
	import /opt/monohost/caddy/apps/*.caddy

	# "/" and anything unmatched — reserved for a future homepage. Placeholder for now.
	handle {
		respond "monohost — dashboard at /dashboard/" 404
	}
}

# --- Public (Cloudflare tunnel) -------------------------------------------------
# The tunnel sends each public hostname to this :80 listener; Caddy demuxes by Host header.

# DEV zone: one shared host per domain (https://<dev_base>/<name>/), path-routed. Host blocks (one per
# registered domain) are GENERATED from zones.env + registry/domains.tsv into caddy/public-dev-host/,
# each importing its domain's per-app path fragments from caddy/public-dev/<domain>/. No literal
# domain lives in this file. Empty glob is a no-op.
import /opt/monohost/caddy/public-dev-host/*.caddy

# PROD zone: one standalone subdomain site block per app (https://<name>.<BASE_DOMAIN>/, served at
# root), written by expose.sh into caddy/public/. Each is covered by the *.<BASE_DOMAIN> cert.
import /opt/monohost/caddy/public/*.caddy
