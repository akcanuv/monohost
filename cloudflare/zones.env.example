# monohost Cloudflare zone config — TEMPLATE (placeholders only; never a real domain).
# The installer GENERATES the live /opt/monohost/cloudflare/zones.env from your prompted domain and
# the tunnel it creates (cloudflared tunnel login + create). This file documents the shape.
#
#   BASE_DOMAIN  your Cloudflare-managed apex/zone (prod apps -> <name>.<BASE_DOMAIN>)
#   DEV_BASE     the shared dev host, exactly one label under BASE_DOMAIN (dev apps -> <DEV_BASE>/<name>/)
#   TUNNEL       the tunnel UUID (from `cloudflared tunnel create`)
#   CREDS_FILE   path to the tunnel credentials JSON copied into /opt/monohost/cloudflare/
BASE_DOMAIN=REPLACE-DOMAIN.example
DEV_BASE=dev.REPLACE-DOMAIN.example
TUNNEL=REPLACE-TUNNEL-UUID
CREDS_FILE=/opt/monohost/cloudflare/REPLACE-UUID.json
